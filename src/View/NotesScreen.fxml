<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1000.0" styleClass="border-pane" stylesheets="@../Resources/generalStylesheet.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.NotesScreenController">
    <center>
       <VBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" spacing="15.0" styleClass="vbox" stylesheets="@../Resources/generalStylesheet.css" BorderPane.alignment="CENTER">
          <children>
             <Label text="CUSTOMER NOTES">
                <font>
                   <Font name="System Bold" size="20.0" />
                </font>
             </Label>
             <Label fx:id="customerNameLbl" text="Notes">
                <font>
                   <Font name="System Bold" size="14.0" />
                </font>
             </Label>
             <TableView fx:id="noteTableView" prefHeight="280.0" prefWidth="960.0">
               <columns>
                   <TableColumn fx:id="idCol" minWidth="80.0" prefWidth="80.0" text="ID" />
                   <TableColumn fx:id="noteCol" minWidth="500.0" prefWidth="500.0" text="Note" />
                   <TableColumn fx:id="createdByCol" minWidth="140.0" prefWidth="140.0" text="Created By" />
                   <TableColumn fx:id="lastUpdateCol" minWidth="200.0" prefWidth="200.0" text="Last Updated" />
               </columns>
             </TableView>
             <Label text="Note Text">
                <font>
                   <Font name="System Bold" size="12.0" />
                </font>
             </Label>
             <TextArea fx:id="noteTextArea" prefHeight="120.0" prefWidth="960.0" promptText="Enter note text" wrapText="true" />
             <HBox alignment="CENTER" prefHeight="25.0" prefWidth="200.0" spacing="20.0">
                <children>
                   <Button fx:id="newBtn" minHeight="30.0" mnemonicParsing="false" onAction="#onActionNew" prefHeight="30.0" prefWidth="100.0" text="New" />
                   <Button fx:id="saveBtn" minHeight="30.0" mnemonicParsing="false" onAction="#onActionSave" prefHeight="30.0" prefWidth="100.0" text="Save" />
                   <Button fx:id="deleteBtn" minHeight="30.0" mnemonicParsing="false" onAction="#onActionDelete" prefHeight="30.0" prefWidth="100.0" text="Delete" />
                   <Button fx:id="backBtn" minHeight="30.0" mnemonicParsing="false" onAction="#onActionReturn" prefHeight="30.0" prefWidth="100.0" text="Back">
                      <HBox.margin>
                         <Insets left="100.0" />
                      </HBox.margin>
                   </Button>
                </children>
             </HBox>
             <Label fx:id="errorLbl" prefHeight="34.0" prefWidth="600.0" textFill="#b50000" wrapText="true" />
          </children>
          <padding>
             <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
       </VBox>
    </center>
 </BorderPane>
